# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/waboranggae"

# Server
PORT=8787
NODE_ENV=development

# JWT (Change in production!)
JWT_SECRET=your-super-secret-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this

# Ollama (optional)
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# TourAPI (optional) — 한국관광공사 국문관광정보
TOUR_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# 버스정류장 (TAGO) — 미설정 시 TOUR_API_KEY 재사용
BUS_STOP_API_KEY=
BUS_STOP_API_BASE_URL=https://apis.data.go.kr/1613000/BusSttnInfoInqireService

# 물품보관함 / 공영자전거 (행안부 통합) — 미설정 시 TOUR_API_KEY 재사용
LOCKER_API_KEY=
LOCKER_API_BASE_URL=https://apis.data.go.kr/B551982/psl_v2
BIKE_API_BASE_URL=https://apis.data.go.kr/B551982/pbdo_v2

# Expo (for mobile app)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
