# 앱 빌드 시 공개되는 API 서버 주소 (비밀값을 넣지 마세요)
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# API 서버
NODE_ENV=production
PORT=8787
CORS_ORIGINS=https://app.example.com

# PostgreSQL: 운영 DB의 SSL 요구사항에 맞는 연결 문자열 사용
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/waboranggae?sslmode=require

# 충분히 긴 무작위 값으로 교체하고 비밀 저장소에 보관
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret

# Ollama는 인터넷에 직접 공개하지 않고 API 서버만 접근 가능한 사설 주소 사용
OLLAMA_ENABLED=true
OLLAMA_URL=http://ollama-private:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=90000
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
# 운영 기본값: 버튼 추천 응답을 지연시키지 않도록 LLM 코스 계획은 끕니다.
OLLAMA_COURSE_PLANNER_ENABLED=false

# apis.data.go.kr 공통 서비스키는 서버 비밀 환경변수로만 설정
DATA_GO_KR_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TMAP_TRANSIT_API_KEY=
TMAP_TRANSIT_API_URL=https://apis.openapi.sk.com/transit/routes
TMAP_LIVE_COURSE_LIMIT=1
TMAP_DAILY_REQUEST_LIMIT=10
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=waboranggae-app/1.0 (https://github.com/tae0623/waboranggae-app)
NOMINATIM_CONTACT_EMAIL=
START_LOCATION_OVERRIDES_JSON=
BUS_STOP_API_BASE_URL=https://apis.data.go.kr/1613000/BusSttnInfoInqireService
BUS_ROUTE_API_BASE_URL=https://apis.data.go.kr/1613000/BusRouteInfoInqireService
LOCKER_API_BASE_URL=https://apis.data.go.kr/B551982/psl_v2
