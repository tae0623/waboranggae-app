# 앱 빌드 시 공개되는 API 서버 주소 (비밀값을 넣지 마세요)
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# API 서버
NODE_ENV=production
PORT=8787
CORS_ORIGINS=https://app.example.com
# 카카오·구글 콜백 및 개인정보 URL에 쓰일 고정 HTTPS origin. 임시 터널 금지.
PUBLIC_APP_URL=https://api.example.com
TEAM_DEV_MODE=false
ALLOW_DEMO_COURSE_FALLBACK=false
# 배포 서비스가 문서화한 프록시 주소/CIDR만 지정 (true/1/전체 인터넷 허용 금지)
TRUST_PROXY=
QUOTA_STORE=database

# PostgreSQL: 운영 DB의 SSL 요구사항에 맞는 연결 문자열 사용
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/waboranggae?sslmode=require

# 충분히 긴 무작위 값으로 교체하고 비밀 저장소에 보관
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
# 서버 간 동일하게 유지할 별도의 무작위 암호 (32자 이상). 임시 소셜 인증 DB 암호화.
OAUTH_FLOW_ENCRYPTION_KEY=

# Ollama는 인터넷에 직접 공개하지 않고 API 서버만 접근 가능한 사설 주소 사용
OLLAMA_ENABLED=false
OLLAMA_URL=http://ollama-private:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=15000
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
# 운영 기본값: 버튼 추천 응답을 지연시키지 않도록 LLM 코스 계획은 끕니다.
OLLAMA_COURSE_PLANNER_ENABLED=false

# apis.data.go.kr 공통 서비스키는 서버 비밀 환경변수로만 설정
DATA_GO_KR_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# 지역 수요: 체류(21)·소비(22) 평균, 최근 데이터가 있는 동일 월 사용
DATALAB_DEMAND_STAY_URL=https://apis.data.go.kr/B551011/AreaTarDemDsService
DATALAB_DEMAND_CONSUME_URL=https://apis.data.go.kr/B551011/AreaTarDemDsService
PHOTO_KOREA_BASE_URL=https://apis.data.go.kr/B551011/PhotoGalleryService1
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=waboranggae-app/1.0 (https://github.com/tae0623/waboranggae-app)
NOMINATIM_CONTACT_EMAIL=
START_LOCATION_OVERRIDES_JSON=
BUS_STOP_API_BASE_URL=https://apis.data.go.kr/1613000/BusSttnInfoInqireService
BUS_ROUTE_API_BASE_URL=https://apis.data.go.kr/1613000/BusRouteInfoInqireService
LOCKER_API_BASE_URL=https://apis.data.go.kr/B551982/psl_v2
# 카카오맵 (JavaScript 키만 지도 HTML에 공개되며 REST 키는 서버에만 저장)
KAKAO_MAP_JS_KEY=
KAKAO_REST_API_KEY=
# 위 REST 키로 도시명 가볼만한곳/맛집 추천 후보도 조회합니다. 새 키 불필요.
KAKAO_FREE_TIER_CONFIRMED=false
# 합산 일일 보호 한도 0~1000. 최종 테스트 값 1000을 운영에 그대로 복사하지 말고 재검토.
KAKAO_DAILY_REQUEST_LIMIT=200
# 사용자가 확정한 실제 운영 주체
PRIVACY_OPERATOR_NAME="뚜버기 Team (administrator: Taeyoung Ko)"
