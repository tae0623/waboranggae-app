# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/waboranggae"

# Server
PORT=8787
NODE_ENV=development
# 배포한 웹 앱 주소가 여러 개면 쉼표로 구분 (네이티브 앱은 보통 Origin 헤더가 없음)
CORS_ORIGINS=

# JWT (Change in production!)
JWT_SECRET=your-super-secret-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this

# Ollama (optional)
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=90000
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
# 기본 false: 버튼 추천은 빠른 규칙+검증, true는 LLM 코스 계획 실험용
OLLAMA_COURSE_PLANNER_ENABLED=false

# apis.data.go.kr 공통 서비스키 (TourAPI·정류소·버스노선·공영 물품보관함)
DATA_GO_KR_KEY=

# 시연 코스 폴백 (기본 true). false면 TourAPI 실패/키 없음 시 빈 결과만 반환합니다.
ALLOW_DEMO_COURSE_FALLBACK=true
# 앱이 서버에 못 붙을 때 로컬 시연 코스를 쓸지 (Expo 공개 변수)
EXPO_PUBLIC_ALLOW_DEMO_COURSE_FALLBACK=true

# TourAPI (optional) — 한국관광공사 국문관광정보
# 2026-07-01 전남광주통합특별시 법정동 코드 개편 대응
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# 길찾기 — TMAP Transit 앱키를 서버에만 저장합니다. 미설정 시 좌표 기반 예상 경로로 동작합니다.
TMAP_TRANSIT_API_KEY=
TMAP_TRANSIT_API_URL=https://apis.openapi.sk.com/transit/routes
# 무료 호출 보호: 1순위 코스만 실경로를 받고, 하루 최대 10개의 외부 요청을 예약합니다.
TMAP_LIVE_COURSE_LIMIT=1
TMAP_DAILY_REQUEST_LIMIT=10

# 역·터미널 좌표 검색 — 공개 Nominatim 정책에 맞춰 식별 가능한 User-Agent/이메일을 설정합니다.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=waboranggae-app/1.0 (https://github.com/tae0623/waboranggae-app)
NOMINATIM_CONTACT_EMAIL=
# 선택 사항: 외부 검색 없이 쓸 출발지 좌표. 예: {"순천 터미널":{"address":"...","latitude":34.9476,"longitude":127.4914}}
START_LOCATION_OVERRIDES_JSON=

# 버스정류장 (TAGO) — 공공데이터포털에서 해당 API 활용신청 필요
BUS_STOP_API_BASE_URL=https://apis.data.go.kr/1613000/BusSttnInfoInqireService
# 버스노선 (TAGO) — 정류장별 경유노선의 배차정보 보강용
BUS_ROUTE_API_BASE_URL=https://apis.data.go.kr/1613000/BusRouteInfoInqireService

# 공영 물품보관함 (행안부 통합) — 실제 제공 지역에서만 표시하며 데모 폴백 없음
LOCKER_API_BASE_URL=https://apis.data.go.kr/B551982/psl_v2

# Expo (for mobile app)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
