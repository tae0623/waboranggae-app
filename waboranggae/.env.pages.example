# Cloudflare Pages runtime bindings. Do not use VITE_ for these values.
# Keep production bindings out of preview deployments. Missing values return 503.
TEAM_WEB_ORIGIN=https://YOUR-PROJECT.pages.dev
# Fresh random secrets, distinct from old team credentials and all existing server keys.
TEAM_WEB_PASSWORD=
TEAM_WEB_SESSION_SECRET=
TEAM_WEB_API_KEY=
TEAM_WEB_API_EXPIRES_AT=
# Username for the team admission gate is team. App members sign in separately.
# Supabase stores only SHA-256(TEAM_WEB_API_KEY) in EDGE_TEAM_WEB_VALIDATION_HASH,
# plus EDGE_TEAM_WEB_VALIDATION_EXPIRES_AT. It must be deployed with matching code.
