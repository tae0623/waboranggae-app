# Copy these settings into .env on the API server, NEVER into VITE_ or EXPO_PUBLIC_ variables.
PUBLIC_APP_URL=https://your-api.example.com
KAKAO_LOGIN_ENABLED=false
# Uses the existing KAKAO_REST_API_KEY.
KAKAO_OAUTH_CLIENT_SECRET=
GOOGLE_LOGIN_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Callback URLs to register in the provider console:
# <PUBLIC_APP_URL>/auth/social/kakao/callback
# <PUBLIC_APP_URL>/auth/social/google/callback
# Weather uses the existing DATA_GO_KR_KEY (apply for KMA short-term forecast service).
