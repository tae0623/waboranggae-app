// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 사용자 모델
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  displayName    String?
  password       String?  // 비밀번호 (bcrypt 해시)
  tokenVersion   Int      @default(0)  // 토큰 무효화용 버전 (비밀번호 변경 시 증가)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 관계
  bookmarks      Bookmark[]
  searchHistory  SearchHistory[]

  @@map("users")
}

// 코스 북마크 (찜하기)
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  courseId  String   // 외부 참조: Course ID
  courseName String  // 디노멀라이제이션: 나중에 조회할 수 있도록
  city      String   // 어느 지역인지
  createdAt DateTime @default(now())

  // 관계
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("bookmarks")
}

// 검색 이력
model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String   // 원본 검색어
  city      String?  // 추출된 도시
  pace      String?  // 추출된 속도 (easy|balanced|full)
  createdAt DateTime @default(now())

  // 관계
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("search_history")
}
