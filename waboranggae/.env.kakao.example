# Copy these names into .env (never commit actual REST keys).
# Kakao Developers > App > Platform keys
KAKAO_MAP_JS_KEY=
KAKAO_REST_API_KEY=
# Set true only after confirming "카카오맵 무료 쿼터" on this app, with paid API disabled.
KAKAO_FREE_TIER_CONFIRMED=false
# Per-server daily protective limit, shared by route/search calls; persisted across restarts.
KAKAO_DAILY_REQUEST_LIMIT=200

