{
  "name": "waboranggae-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:web": "expo export --platform web",
    "verify": "pnpm typecheck && pnpm test && pnpm export:web"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo": "^57.0.7",
    "expo-linear-gradient": "^57.0.1",
    "expo-status-bar": "^57.0.1",
    "express": "^5.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.17",
    "babel-preset-expo": "^57.0.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
